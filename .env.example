# Copy to .env.local for local dev. In production, set these in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=your-gemini-key-here
# Optional. Default tries gemini-3.8-flash, then gemini-3.6-flash
# GEMINI_MODEL=gemini-3.8-flash
# Long random string, e.g. `openssl rand -hex 32`
PROOF_SECRET=change-me-to-a-long-random-string
